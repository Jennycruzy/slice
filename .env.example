NODE_ENV=development
PORT=8787
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgres://slice:slice@localhost:5432/slice

# Shannon testnet. The executor key is the only private key accepted by the server.
NETWORK=testnet
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
MARKETS_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
EXECUTOR_PRIVATE_KEY=

# Deploy SliceSessionPolicy and set its address before enabling execution.
SESSION_POLICY_ADDRESS=

# Deploy SliceExecutionRouter with the session-policy address. This is the
# non-custodial bridge used because DreamDEX binary `placeBinaryOrderFor` is
# allowlisted; the router calls the public binary placement function.
EXECUTION_ROUTER_ADDRESS=

# Optional, only for the on-chain Reactivity subscription deployment tool.
# This is a separate deployment owner key, never the API executor key.
REACTIVITY_OWNER_PRIVATE_KEY=
REACTIVITY_HANDLER_ADDRESS=
REACTIVITY_EMITTER_ADDRESS=
REACTIVITY_PRIORITY_FEE_PER_GAS=
REACTIVITY_MAX_FEE_PER_GAS=
REACTIVITY_GAS_LIMIT=
REACTIVITY_SUBSCRIPTION_ID=

# Optional bounded two-sided liquidity seed. It reuses the delegated executor
# account; it is disabled until every live venue value is configured.
QUOTER_ENABLED=false
QUOTER_MARKET_ID=
QUOTER_OUTCOME=YES
QUOTER_QUANTITY=
QUOTER_SPREAD_TICKS=
QUOTER_REFRESH_SECONDS=

# Browser build values (set in apps/web/.env.local when the API is not same-origin).
# VITE_API_URL=http://localhost:8787
# VITE_API_PROXY_TARGET=http://localhost:8787
# VITE_SESSION_DURATION_SECONDS=3600
