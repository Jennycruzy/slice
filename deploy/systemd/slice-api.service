[Unit]
Description=Slice execution API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/slice
EnvironmentFile=/home/ubuntu/slice/.env
ExecStart=/usr/bin/node /home/ubuntu/slice/apps/api/dist/server.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
